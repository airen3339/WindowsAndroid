+//
+// Optional fw_cfg file holding the host's preferred display size as ASCII
+// "<width>x<height>" (e.g. "1920x1080"). When present, that size is offered as
+// an extra mode and made the initial one, so the console and the OS loader
+// (which keeps the boot-time GOP mode) run at the host display's resolution.
+//
+#define RAMFB_RESOLUTION_FWCFG  "opt/org.windowsandroid/ramfb-resolution"
+#define RAMFB_MAX_WIDTH         7680
+#define RAMFB_MAX_HEIGHT        4320
+
 #pragma pack (1)
 typedef struct RAMFB_CONFIG {
   UINT64    Address;
@@ -54,11 +65,15 @@ STATIC EFI_GRAPHICS_OUTPUT_MODE_INFORMATION  mQemuRamfbModeInfo[] = {
