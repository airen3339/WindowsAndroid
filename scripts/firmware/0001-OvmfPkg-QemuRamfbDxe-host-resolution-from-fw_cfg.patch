+    0,    // Version
+    0,    // HorizontalResolution: from RAMFB_RESOLUTION_FWCFG, if any
+    0,    // VerticalResolution
   }
 };
 
 STATIC EFI_GRAPHICS_OUTPUT_PROTOCOL_MODE  mQemuRamfbMode = {
-  ARRAY_SIZE (mQemuRamfbModeInfo),                // MaxMode
+  ARRAY_SIZE (mQemuRamfbModeInfo) - 1,            // MaxMode
   0,                                              // Mode
   mQemuRamfbModeInfo,                             // Info
   sizeof (EFI_GRAPHICS_OUTPUT_MODE_INFORMATION),  // SizeOfInfo
@@ -234,6 +249,79 @@ STATIC EFI_GRAPHICS_OUTPUT_PROTOCOL  mQemuRamfbGraphicsOutput = {
   &mQemuRamfbMode,
 };
 
+/**
+  Read the host's preferred resolution from fw_cfg and offer it as a mode.
+
+  @return  The mode to start in: the preferred one, or 800 x 600 without one.
+**/
+STATIC
+UINT32
+QemuRamfbHostResolutionMode (
+  VOID
+  )
+{
+  FIRMWARE_CONFIG_ITEM  Item;
+  UINTN                 Size;
+  CHAR8                 Text[32];
+  CHAR8                 *End;
+  UINTN                 Width;
+  UINTN                 Height;
+  UINT32                Index;
+  RETURN_STATUS         Status;
+
+  Status = QemuFwCfgFindFile (RAMFB_RESOLUTION_FWCFG, &Item, &Size);
+  if (RETURN_ERROR (Status) || (Size == 0) || (Size >= sizeof (Text))) {
+    return 1;
+  }
+
+  QemuFwCfgSelectItem (Item);
+  QemuFwCfgReadBytes (Size, Text);
+  Text[Size] = '\0';
+
+  Status = AsciiStrDecimalToUintnS (Text, &End, &Width);
+  if (RETURN_ERROR (Status) || ((*End != 'x') && (*End != 'X'))) {
+    return 1;
+  }
+
+  Status = AsciiStrDecimalToUintnS (End + 1, &End, &Height);
+  if (RETURN_ERROR (Status) ||
+      (Width < 640) || (Height < 480) ||
+      (Width > RAMFB_MAX_WIDTH) || (Height > RAMFB_MAX_HEIGHT))
+  {
+    DEBUG ((DEBUG_WARN, "Ramfb: ignoring host resolution \"%a\"\n", Text));
+    return 1;
+  }
+
+  for (Index = 0; Index < mQemuRamfbMode.MaxMode; Index++) {
+    if ((mQemuRamfbModeInfo[Index].HorizontalResolution == Width) &&
+        (mQemuRamfbModeInfo[Index].VerticalResolution == Height))
+    {
+      break;
+    }
+  }
+
+  if (Index == mQemuRamfbMode.MaxMode) {
+    mQemuRamfbModeInfo[Index].HorizontalResolution = (UINT32)Width;
+    mQemuRamfbModeInfo[Index].VerticalResolution   = (UINT32)Height;
+    mQemuRamfbMode.MaxMode++;
+  }
+
+  //
+  // GraphicsConsoleDxe switches to the mode these name; keep a resolution
+  // the user picked in the platform setup form (source 1) if there is one.
+  //
+  if (PcdGet8 (PcdVideoResolutionSource) == 0) {
+    PcdSet32S (PcdVideoHorizontalResolution, (UINT32)Width);
+    PcdSet32S (PcdSetupVideoHorizontalResolution, (UINT32)Width);
+    PcdSet32S (PcdVideoVerticalResolution, (UINT32)Height);
+    PcdSet32S (PcdSetupVideoVerticalResolution, (UINT32)Height);
+    PcdSet8S (PcdVideoResolutionSource, 2);
+  }
+
+  DEBUG ((DEBUG_INFO, "Ramfb: host resolution %ux%u (mode %u)\n", (UINT32)Width, (UINT32)Height, Index));
+  return Index;
+}
+
